[resource]
script = ExtResource("1")
town_id = &"zema"
town_name = "Zema \u2014 Petrified Town"
shop_items = [ExtResource("2"), ExtResource("3"), ExtResource("4"), ExtResource("5"), ExtResource("6"), ExtResource("7"), ExtResource("8"), ExtResource("9")]
has_inn = true
inn_cost_multiplier = 1.5
npcs = [{"name": "Petrified Elder", "lines": ["... ... ... (The stone figure stares ahead, mouth frozen mid-sentence. Whatever happened here struck without warning.)", "If you look closely, you can see the terror in their eyes. They knew it was coming -- but only for a second."], "requires_flag": ""}, {"name": "Wandering Scholar", "lines": ["I came from Piata to study this phenomenon. Every inhabitant, petrified in an instant.", "The ancient texts mention a medicine called Alshline that could reverse petrification. But it only grows deep in Birth Valley.", "If we could retrieve the Alshline, perhaps we could save these people. But the valley is crawling with monsters."], "requires_flag": ""}, {"name": "Traveling Merchant", "lines": ["Even in a town of stone, there's business to be done. The valley ores make fine weapons.", "I set up shop here after the petrification. Someone has to serve the hunters passing through.", "Be careful in the valley. The creatures there are stronger than anything in Piata's basement."], "requires_flag": ""}]
