"context_subtitle": "SETTLEMENT OVERVIEW PLACEHOLDER",
"context_title": "MOTAVIA MAP: PIATA REGION",
"description": "A distinguished seat of learning on Motavia. Scholars study the ancient past while hunters gather in the town square.",
"dialogue": "Alys\u2014this is the Academy! We could learn a ton if we just take a quick look around\u2026",
"dialogue_thread": [{
"speaker": "Chaz Ashley",
"dialogue": "Alys\u2014this is the Academy! We could learn a ton if we just take a quick look around\u2026",
"portrait_code": "CHAZ / HUNTER",
"portrait_image": "res://assets/textures/portraits/chaz_portrait.png"
}, {
"speaker": "Alys Brangwin",
"dialogue": "And we can do the grand tour right after we collect our paycheck. Principal\u2019s office, rookie\u2014try not to get distracted by the education.",
"portrait_code": "ALYS / HUNTER",
"portrait_image": "res://assets/textures/portraits/alys_portrait.png"
}, {
"speaker": "Chaz Ashley",
"dialogue": "H-hey! Okay\u2014principal\u2019s office. No touring. Mostly.",
"portrait_code": "CHAZ / HUNTER",
"portrait_image": "res://assets/textures/portraits/chaz_portrait.png"
}],
