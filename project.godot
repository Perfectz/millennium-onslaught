[layer_names]

3d_physics/layer_1="environment"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="player_hitbox"
3d_physics/layer_5="enemy_hitbox"
3d_physics/layer_6="player_hurtbox"
3d_physics/layer_7="enemy_hurtbox"
3d_physics/layer_8="platform"
3d_physics/layer_9="trigger"
3d_physics/layer_10="pickup"

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.1, 0.1, 0.15, 0)
viewport/transparent_background=true
anti_aliasing/quality/screen_space_aa=1
